---
import { FIGURES } from "../figures";

interface Props {
  name: string;
}
const { name } = Astro.props;
const figure = FIGURES[name];
if (!figure) throw new Error(`Unknown figure: ${name}`);
const { caption, brief, sketch, src, alt, width, frame } = figure;
---

{
  src ? (
    <figure class="figure" style={width ? `max-width: ${width}` : undefined}>
      <img class:list={{ frame }} src={src} alt={alt ?? caption} loading="lazy" decoding="async" />
      <figcaption>{caption}</figcaption>
    </figure>
  ) : (
    <figure class="figure todo" data-figure={name}>
      <p class="label">Figure to draw · {name}</p>
      <p class="brief">{brief}</p>
      <pre class="sketch" aria-hidden="true">{sketch}</pre>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}

<style>
  .figure {
    margin: 1.75rem 0;
  }
  .figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  img.frame {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.9rem;
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .todo {
    padding: 1.1rem 1.25rem;
    border: 2px dashed #e0c24a;
    border-radius: 1rem;
    background: var(--sl-color-accent-low);
  }
  .label {
    margin: 0 0 0.5rem;
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .brief {
    margin: 0 0 0.9rem;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
  }
  .sketch {
    margin: 0 0 0.6rem;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    border-radius: 0.6rem;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
</style>
