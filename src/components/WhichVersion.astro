---
/** The three questions that lead to a version of Owload. A "yes" ends in a version, a "no" goes on to the next question. */
interface Step {
  question: string;
  title: string;
  note: string;
  href: string;
  icon: string[];
}

const STEPS: Step[] = [
  {
    question: "Just want to try it or use it?",
    title: "Web version",
    note: "owload.com, 3 GB on the free plan",
    href: "#web-version",
    icon: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "M2 12h20", "M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"],
  },
  {
    question: "Need more than 3 GB, or the files in your own storage?",
    title: "Web with your own S3",
    note: "The app at Owload, files in your bucket",
    href: "#web-version-with-your-own-s3",
    icon: ["M12 8c4.97 0 9-1.34 9-3s-4.03-3-9-3-9 1.34-9 3 4.03 3 9 3z", "M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5", "M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"],
  },
  {
    question: "Nothing of yours may be on Owload's servers?",
    title: "Self-hosted",
    note: "Everything runs on your server",
    href: "../self-hosting/",
    icon: ["M4 3h16a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z", "M4 13h16a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1z", "M7 7.5h.01", "M7 17.5h.01"],
  },
];
---

<div class="tree" role="list" aria-label="Which version to take">
  {
    STEPS.map((step, i) => (
      <div class="step" role="listitem">
        <div class="q">
          <span class="n">{i + 1}</span>
          <span class="q-text">{step.question}</span>
        </div>
        <div class="yes"><span class="pill">yes</span></div>
        <a class="out" href={step.href}>
          <span class="tile">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {step.icon.map((d) => <path d={d} />)}
            </svg>
          </span>
          <span class="out-text">
            <span class="out-title">{step.title}</span>
            <span class="out-note">{step.note}</span>
          </span>
        </a>
        {i < STEPS.length - 1 && <div class="no"><span class="pill">no</span></div>}
      </div>
    ))
  }
</div>

<style>
  .tree {
    --yellow: #fadb58;
    --ink: #1d1c19;
    --line: var(--sl-color-white);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 1.5rem 0;
    padding: 1.25rem;
    border-radius: 1.25rem;
    background: var(--sl-color-gray-6);
  }
  /* Starlight spaces the elements of the page text; the diagram sets its own gaps */
  .tree,
  .tree * {
    margin-top: 0;
    margin-bottom: 0;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .q {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-black);
  }
  .n {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--yellow);
    font-size: var(--sl-text-sm);
    font-weight: 800;
  }
  .q-text {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    font-weight: 800;
    line-height: 1.3;
  }

  /* the connectors: a line with an arrow head and a small label */
  .yes,
  .no {
    position: relative;
    flex: none;
    width: 2px;
    height: 2.5rem;
    margin-left: 1.9rem;
    background: var(--line);
  }
  .yes::after,
  .no::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    border-top: 7px solid var(--line);
    border-right: 5px solid transparent;
    border-left: 5px solid transparent;
  }
  .pill {
    position: absolute;
    top: 50%;
    left: 0.7rem;
    transform: translateY(-50%);
    padding: 0.05rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
  }

  .out {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border: 1px solid #3a3935;
    border-radius: 1rem;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
  }
  .out:hover {
    border-color: var(--yellow);
  }
  .tile {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.7rem;
    background: var(--yellow);
    color: var(--ink);
  }
  .out-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .out-title {
    font-size: var(--sl-text-base);
    font-weight: 800;
    line-height: 1.3;
  }
  .out-note {
    color: #a3a39d;
    font-size: var(--sl-text-sm);
    line-height: 1.35;
  }

  /* wide page: the questions go side by side, rows line up across them, and "no" is an arrow to the next question */
  @media (min-width: 46rem) {
    .tree {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 3.25rem;
      padding: 1.1rem;
    }
    .step {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
    }
    .q,
    .yes,
    .out {
      grid-column: 1;
    }
    .q {
      grid-row: 1;
    }
    .yes {
      grid-row: 2;
    }
    .out {
      grid-row: 3;
    }
    .no {
      grid-row: 1;
      grid-column: 1;
      justify-self: end;
      align-self: center;
      width: 3.25rem;
      height: 2px;
      margin: 0 -3.25rem 0 0;
    }
    .no::after {
      top: 50%;
      right: -1px;
      bottom: auto;
      left: auto;
      transform: translateY(-50%);
      border-top: 5px solid transparent;
      border-right: 0;
      border-bottom: 5px solid transparent;
      border-left: 7px solid var(--line);
    }
    .no .pill {
      top: auto;
      bottom: 0.45rem;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
