---
/** The three ways to use Owload side by side: who runs the app, where the encrypted files are kept, and the limit. */
interface Tile {
  owner: "owload" | "you";
  small: string;
  main: string;
}
interface Way {
  name: string;
  note: string;
  tiles: [Tile, Tile, Tile];
}

const ROWS = ["The app runs on", "Encrypted files are kept in", "Storage limit"];

const WAYS: Way[] = [
  {
    name: "Web",
    note: "owload.com",
    tiles: [
      { owner: "owload", small: "Owload", main: "Owload servers" },
      { owner: "owload", small: "Owload", main: "Owload storage" },
      { owner: "owload", small: "Set by Owload", main: "3 GB, free plan" },
    ],
  },
  {
    name: "Web + your own S3",
    note: "owload.com with your bucket",
    tiles: [
      { owner: "owload", small: "Owload", main: "Owload servers" },
      { owner: "you", small: "You", main: "Your S3 bucket" },
      { owner: "you", small: "Set by your storage", main: "No limit from us" },
    ],
  },
  {
    name: "Self-hosted",
    note: "your own install",
    tiles: [
      { owner: "you", small: "You", main: "Your server" },
      { owner: "you", small: "You", main: "Your storage" },
      { owner: "you", small: "Set by your storage", main: "No limit from us" },
    ],
  },
];
---

<div class="ways" role="group" aria-label="The three ways to use Owload">
  <div class="labels" aria-hidden="true">
    <span></span>
    {ROWS.map((row) => <span class="label">{row}</span>)}
  </div>

  {
    WAYS.map((way) => (
      <section class="way">
        <h3 class="head">
          <span class="name">{way.name}</span>
          <span class="note">{way.note}</span>
        </h3>
        {way.tiles.map((tile, i) => (
          <div class={`tile ${tile.owner}`}>
            <span class="row">{ROWS[i]}</span>
            <span class="small">{tile.small}</span>
            <span class="main">{tile.main}</span>
          </div>
        ))}
      </section>
    ))
  }

  <div class="keys">
    <span class="key-label" aria-hidden="true">Encryption keys</span>
    <div class="band">
      <span class="key-icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"></circle><path d="M11 12l9-9"></path><path d="M16 7l3 3"></path></svg>
      </span>
      <span class="band-text">Keys stay on your device, always</span>
      <span class="band-note">same in all three</span>
    </div>
  </div>

  <div class="legend" aria-hidden="true">
    <span><i class="swatch owload"></i>Run by Owload</span>
    <span><i class="swatch you"></i>Yours</span>
  </div>
</div>

<style>
  .ways {
    --yellow: #f5dc6f;
    --ink: #1d1c19;
    display: grid;
    grid-template-columns: 6.5rem repeat(3, minmax(0, 1fr));
    max-width: 40rem;
    grid-template-rows: auto repeat(3, auto) auto auto;
    column-gap: 0.5rem;
    row-gap: 0.4rem;
    margin: 1.5rem 0;
  }
  /* Starlight spaces siblings in the page text; the table sets its own gaps */
  .ways *,
  .ways *::before {
    margin-top: 0;
    margin-bottom: 0;
  }
  .labels,
  .way {
    display: grid;
    grid-row: 1 / 5;
    grid-template-rows: subgrid;
    row-gap: 0.4rem;
  }
  .label,
  .key-label {
    align-self: center;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    line-height: 1.3;
  }
  .head {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding-bottom: 0.2rem;
    font-size: inherit;
    line-height: 1.25;
  }
  .name {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    font-weight: 800;
  }
  .note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    font-weight: 400;
  }
  .tile {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
  .tile.owload {
    border-color: var(--yellow);
    background: var(--yellow);
    color: var(--ink);
  }
  .small {
    font-size: var(--sl-text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .main {
    font-size: var(--sl-text-sm);
    font-weight: 800;
    line-height: 1.25;
  }
  /* the name of the row is in the labels column on a wide page, and inside each tile on a narrow one */
  .row {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .keys {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
  }
  .band {
    display: flex;
    grid-column: 2 / -1;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.75rem;
    background: var(--ink);
    color: #fff;
  }
  .key-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
  }
  .band-text {
    font-size: var(--sl-text-sm);
    font-weight: 800;
  }
  .band-note {
    margin-left: auto;
    color: #a3a39d;
    font-size: var(--sl-text-sm);
  }
  .legend {
    display: flex;
    grid-column: 2 / -1;
    gap: 1.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .legend span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swatch {
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.3rem;
    background: var(--sl-color-black);
  }
  .swatch.owload {
    border-color: var(--yellow);
    background: var(--yellow);
  }

  @media (max-width: 46rem) {
    .ways {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .labels,
    .key-label,
    .legend {
      display: none;
    }
    .way {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .row {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      font-size: var(--sl-text-sm);
      opacity: 0.7;
    }
    .keys {
      display: block;
    }
    .band {
      flex-wrap: wrap;
    }
    .band-note {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
