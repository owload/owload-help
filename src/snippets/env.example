# Save this file as .env next to docker-compose.yml and fill it in. Do not commit the result,
# and keep it private (chmod 600 .env).

# --- Where the images are (the Docker Hub account or organisation) and which versions run
DOCKERHUB_NAMESPACE=owload
# Pin a version in production (for example 0.1.2), and take a database dump before changing it. `latest` moves with every release.
BACKEND_VERSION=latest
FRONTEND_VERSION=latest

# --- The database (it runs in this compose project). A long random password without / + = characters (it goes into a URL):
#     openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE

# --- Keycloak (the sign-in service). The issuer is the address of the realm as it appears in the tokens, character for character.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/owload
KEYCLOAK_AUDIENCE=account
APP_KEYCLOAK_URL=https://keycloak.example.com
APP_KEYCLOAK_REALM=owload
APP_KEYCLOAK_CLIENT_ID=front

# --- The addresses of this installation (the ones users type in the browser, with HTTPS). Keycloak's client must list the app address
#     among its valid redirect URIs and web origins.
APP_MAIN_BACKEND_URL=https://api.example.com
APP_URL=https://app.example.com
CORS_ALLOW_ORIGINS=["https://app.example.com"]
TRUSTED_PROXY_HOPS=1

# --- A key for the S3 passwords kept in the database. Make it once, keep a copy away from the server, and never change it: without it
#     every stored S3 password becomes unreadable.
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKEND_SECRET_KEY=CHANGE

# --- Set to true when users connect S3 in your own network, or without HTTPS. Keep false on a service open to the public.
#     The presets are not concerned.
ALLOW_PRIVATE_STORAGE_ENDPOINTS=false

# --- The most the operation logs of one owner's drives may take in the database, in bytes; 0: no limit.
MAX_LOG_BYTES_PER_OWNER=1073741824

# --- How much each user may store in your own storage (the S3 presets), summed over the drives they own, in bytes (3 GiB here). It is the
#     same for everybody; change it and restart the backend to change it for all. A user's own S3 is not held by it.
FREE_PLAN_STORAGE_BYTES=3221225472

# --- Optional: the mail server for invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# A mail service that counts clicks rewrites the links of the mails to an address of its own. For Unisender Go this header turns it off (its support
# has to allow that for the account first); a JSON object:
# SMTP_EXTRA_HEADERS={"X-UNISENDER-GO": "{\"track_links\": 0, \"track_read\": 0}"}
